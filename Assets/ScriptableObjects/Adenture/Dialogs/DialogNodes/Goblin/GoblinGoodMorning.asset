    \u0437\u0440\u0435\u043B\u0438\u0449\u0435, \u0438\u043B\u0438 \u043C\u043D\u0435
    \u043D\u0430\u0439\u0442\u0438 \u043A\u043E\u0433\u043E-\u0442\u043E \u043F\u043E\u0441\u043C\u0435\u043B\u0435\u0435?"
