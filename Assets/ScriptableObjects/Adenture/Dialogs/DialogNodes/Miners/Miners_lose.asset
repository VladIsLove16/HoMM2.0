  m_Name: Miners_lose
  m_EditorClassIdentifier: GameCore::DialogueNodeSO
  nodeId: Miners_lose
  speaker: Miners
  speakerLocalized:
    m_TableReference:
      m_TableCollectionName: 
    m_TableEntryReference:
