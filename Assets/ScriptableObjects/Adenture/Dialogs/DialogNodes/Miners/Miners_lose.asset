      m_Key: 
    m_FallbackState: 0
    m_WaitForCompletion: 0
    m_LocalVariables: []
  text: "\u041E\u0439-\u043E\u0439, \u043F\u043E\u043B\u0435\u0433\u0447\u0435! \u0422\u0432\u043E\u0438
    \u043F\u043E\u0434\u043E\u0441\u0438\u043D\u043E\u0432\u0438\u043A\u0438 \u043A\u0443\u0441\u0430\u044E\u0442\u0441\u044F
    \u0431\u043E\u043B\u044C\u043D\u0435\u0435, \u0447\u0435\u043C \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442.
    \u041B\u0430\u0434\u043D\u043E, \u043F\u0440\u0438\u0437\u043D\u0430\u0435\u043C
    \u2014 \u0442\u044B \u043A\u0440\u0443\u0442. \u041D\u043E \u0435\u0441\u043B\u0438
    \u0445\u043E\u0447\u0435\u0448\u044C \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F
    \u0438\u0437 \u044D\u0442\u043E\u0439 \u0434\u044B\u0440\u044B, \u0442\u0435\u0431\u0435
    \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
    \u0441 \"\u041A\u043E\u043D\u0434\u0438\u0442\u0435\u0440\u0448\u0435\u0439\".
    \u0418\u0449\u0438 \u0435\u0451 \u0434\u043E\u043C\u0438\u043A, \u0438\u043D\u0430\u0447\u0435
    \u0441\u0442\u0440\u0430\u0436\u0430 \u043D\u0430 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0435
    \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442 \u0442\u0435\u0431\u044F
    \u0432 \u043F\u044B\u043B\u044C"
