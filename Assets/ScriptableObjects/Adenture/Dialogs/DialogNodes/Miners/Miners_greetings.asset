  text: "\u041E\u043F\u0430\u043D\u044C\u043A\u0438! \u0413\u043B\u044F\u0434\u0438\u0442\u0435,
    \u0443 \u043C\u0430\u043B\u043E\u0433\u043E \u0430\u0440\u043C\u0438\u044F \u0438\u0437
    \u0434\u0432\u0443\u0445 \u043C\u0443\u0445\u043E\u043C\u043E\u0440\u043E\u0432!
    \u0422\u044B \u0447\u0442\u043E, \u0441\u043E\u0431\u0440\u0430\u043B\u0441\u044F
    \u044D\u0442\u0438\u043C \u0434\u0435\u043B\u0438\u043A\u0430\u0442\u0435\u0441\u043E\u043C
    \u043D\u0430\u0441 \u043D\u0430\u043F\u0443\u0433\u0430\u0442\u044C? \u041C\u044B
    \u0442\u0443\u0442 \u0441\u043A\u0430\u043B\u044B \u0433\u0440\u044B\u0437\u0435\u043C
    \u043D\u0430 \u0437\u0430\u0432\u0442\u0440\u0430\u043A, \u0442\u0430\u043A \u0447\u0442\u043E
    \u043B\u0443\u0447\u0448\u0435 \u0438\u0434\u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u0439
    \u0433\u0435\u0440\u0431\u0430\u0440\u0438\u0439 \u0432 \u0434\u0440\u0443\u0433\u043E\u043C
    \u043C\u0435\u0441\u0442\u0435"
  textLocalized:
    m_TableReference:
      m_TableCollectionName: 
    m_TableEntryReference:
      m_KeyId: 0
      m_Key: 
    m_FallbackState: 0
    m_WaitForCompletion: 0
    m_LocalVariables: []
  choices:
  - Id: 0
    Text: "\u042D\u0442\u0438 \u043C\u0443\u0445\u043E\u043C\u043E\u0440\u044B \u043C\u043E\u0433\u0443\u0442
      \u0431\u044B\u0442\u044C \u043E\u0447\u0435\u043D\u044C \u044F\u0434\u043E\u0432\u0438\u0442\u044B\u043C\u0438.
      \u0425\u043E\u0442\u0438\u0442\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C?"
