  m_Name: BlindWitch_lose
  m_EditorClassIdentifier: GameCore::DialogueNodeSO
  nodeId: BlindWitch_lose
  speaker: BlindWitch
  speakerLocalized:
    m_TableReference:
      m_TableCollectionName: 
    m_TableEntryReference:
      m_KeyId: 0
      m_Key: 
    m_FallbackState: 0
    m_WaitForCompletion: 0
    m_LocalVariables: []
  text: "\u041E\u0439, \u043B\u0430\u0434\u043D\u043E, \u043B\u0430\u0434\u043D\u043E!
    \u0425\u0432\u0430\u0442\u0438\u0442 \u043A\u0440\u0443\u0448\u0438\u0442\u044C
    \u043C\u043E\u044E \u043C\u0435\u0431\u0435\u043B\u044C! \u0412\u0438\u0436\u0443,
    \u0442\u0432\u043E\u0438 \u043F\u043E\u0433\u0430\u043D\u043A\u0438 \u043A\u0443\u0434\u0430
    \u044F\u0434\u043E\u0432\u0438\u0442\u0435\u0435, \u0447\u0435\u043C \u043A\u0430\u0436\u0443\u0442\u0441\u044F
    \u043D\u0430 \u043F\u0435\u0440\u0432\u044B\u0439 \u0432\u0437\u0433\u043B\u044F\u0434.
    \u0417\u0430\u0431\u0438\u0440\u0430\u0439 \u044D\u0442\u0438\u0445 \u043B\u0435\u0441\u043D\u044B\u0445
    \u043C\u043E\u043D\u0441\u0442\u0440\u043E\u0432, \u043E\u043D\u0438 \u0432\u0441\u0451
    \u0440\u0430\u0432\u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0440\u0442\u0438\u043B\u0438
    \u043C\u043E\u0439 \u043F\u043E\u0433\u0440\u0435\u0431 \u0441\u0432\u043E\u0435\u0439
    \u043F\u043B\u0435\u0441\u0435\u043D\u044C\u044E. \u0418\u0434\u0438 \u043A \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0443,
    \u044F \u0434\u0430\u043C \u0441\u0442\u0440\u0430\u0436\u0435 \u0437\u043D\u0430\u043A,
    \u0447\u0442\u043E\u0431\u044B \u0442\u0435\u0431\u044F \u043D\u0435 \u0442\u0440\u043E\u0433\u0430\u043B\u0438...
    \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F!"
