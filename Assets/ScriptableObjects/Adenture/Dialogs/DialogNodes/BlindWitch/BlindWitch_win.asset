    m_LocalVariables: []
  text: "\u0422\u044C\u0444\u0443! \u0410 \u044F-\u0442\u043E \u043D\u0430\u0434\u0435\u044F\u043B\u0430\u0441\u044C
    \u043D\u0430 \u0441\u043E\u0447\u043D\u044B\u0439 \u0443\u0436\u0438\u043D. \u0422\u044B
    \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043D\u0430 \u0441\u0435\u0431\u044F
    \u2014 \u043E\u0434\u043D\u0438 \u043A\u043E\u0441\u0442\u0438 \u0434\u0430 \u043A\u043E\u0436\u0430,
    \u0434\u0430\u0436\u0435 \u0442\u0432\u043E\u0438 \u0433\u0440\u0438\u0431\u044B
    \u0438 \u0442\u0435 \u0441\u043C\u043E\u0440\u0449\u0438\u043B\u0438\u0441\u044C!
    \u041F\u0440\u043E\u0432\u0430\u043B\u0438\u0432\u0430\u0439 \u0441 \u043C\u043E\u0438\u0445
    \u0433\u043B\u0430\u0437, \u043F\u043E\u0433\u0443\u043B\u044F\u0439 \u0435\u0449\u0435
    \u043F\u043E \u043B\u0435\u0441\u0443, \u043D\u0430\u0433\u0443\u043B\u044F\u0439
    \u0436\u0438\u0440\u043E\u043A. \u042F \u043F\u043E\u0434\u043E\u0436\u0434\u0443,
    \u043F\u043E\u043A\u0430 \u0442\u044B \u0441\u0442\u0430\u043D\u0435\u0448\u044C
    \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u044B\u043C \u043C\u043E\u0435\u0433\u043E
    \u0441\u0442\u043E\u043B\u0430. \u0410 \u043D\u0443, \u0431\u0440\u044B\u0441\u044C
    \u0432 \u0447\u0430\u0449\u0443!"
